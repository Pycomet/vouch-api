# Vouch runtime
VOUCH_APP_NAME=Vouch API
VOUCH_APP_VERSION=0.1.0
VOUCH_ENVIRONMENT=development
VOUCH_DEBUG=true
VOUCH_API_V1_PREFIX=/api/v1

# PostgreSQL (local development only)
VOUCH_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vouch
VOUCH_DATABASE_POOL_SIZE=5
VOUCH_DATABASE_MAX_OVERFLOW=10

# JSON array of explicit web client origins
VOUCH_CORS_ORIGINS=["http://localhost:3000"]

# Cities open for inventory (comma-separated slugs, not JSON)
VOUCH_LAUNCHED_CITIES=abuja

# Placeholders pending legal advice (fractions of the rental, 0 <= rate < 1)
VOUCH_COMMISSION_RATE=0.15
VOUCH_DAMAGE_CONTRIBUTION_RATE=0.05

# IANA timezone used for business-day calculations
VOUCH_BUSINESS_TIMEZONE=Africa/Lagos
