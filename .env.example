# Vouch runtime
VOUCH_APP_NAME=Vouch API
VOUCH_APP_VERSION=0.1.0
# development, test, staging, production or phase0. A Phase 0 deployment on the
# fake providers uses phase0: fakes allowed, but strong secrets, debug off and no
# /docs (docs/DEPLOY.md). development (below) is for a local checkout only.
VOUCH_ENVIRONMENT=development
VOUCH_DEBUG=true
VOUCH_API_V1_PREFIX=/api/v1

# PostgreSQL (local development only)
VOUCH_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vouch
VOUCH_DATABASE_POOL_SIZE=5
VOUCH_DATABASE_MAX_OVERFLOW=10

# JSON array of explicit web client origins
VOUCH_CORS_ORIGINS=["http://localhost:3000"]

# Cities open for inventory (comma-separated slugs, not JSON)
VOUCH_LAUNCHED_CITIES=abuja

# Placeholders pending legal advice (fractions of the rental, 0 <= rate < 1)
VOUCH_COMMISSION_RATE=0.15
VOUCH_DAMAGE_CONTRIBUTION_RATE=0.05
# Renter cancellation of a paid booking: fee = rental x rate; the vendor gets
# this share of the fee and Vouch the rest (placeholders pending legal advice)
VOUCH_RENTER_CANCELLATION_FEE_RATE=0.10
VOUCH_CANCELLATION_FEE_VENDOR_SHARE=0.50

# IANA timezone used for business-day calculations
VOUCH_BUSINESS_TIMEZONE=Africa/Lagos

# Booking request limits: the longest rental in days (inclusive), and how many
# days after today (business zone) a rental may start. Both at least 1
VOUCH_MAX_RENTAL_DAYS=90
VOUCH_BOOKING_HORIZON_DAYS=365

# Access tokens (HS256). Set a long random secret (32+ bytes); staging, production and phase0 refuse change-me
VOUCH_JWT_SECRET=change-me
# Token lifetime in minutes (default 7 days)
VOUCH_JWT_TTL_MINUTES=10080

# Phone OTP delivery. Only the in-memory fake exists until an SMS provider is chosen;
# it is refused in staging and production (leave unset there: OTP request answers 503);
# allowed in phase0
VOUCH_OTP_SENDER=fake

# Renter identity and address checks (POST /me/kyc). Only the in-memory fake exists in M2;
# it is refused in staging and production (leave unset there: KYC answers 503);
# allowed in phase0
VOUCH_KYC_PROVIDER=fake

# Payment provider (virtual accounts on accept, webhooks). Only the in-memory fake
# exists in M2; it is refused in staging and production (leave unset there: accept answers 503);
# allowed in phase0
VOUCH_PAYMENT_PROVIDER=fake
# HMAC-SHA256 key for the fake provider's webhook signatures (checked outside development
# and test whenever the fake payment provider is in use: change-me or under 32 bytes is refused)
VOUCH_FAKE_PAYMENT_WEBHOOK_SECRET=change-me

# Largest accepted request body in bytes (default 8 MiB, minimum 1 MiB); 413 above it
VOUCH_MAX_REQUEST_BYTES=8388608

# --- docker compose only (compose.yml); the application does not read these ---
# Password of the compose postgres service. compose.yml builds VOUCH_DATABASE_URL
# from it (host "postgres"), overriding the localhost URL above. Placeholder only.
POSTGRES_PASSWORD=change-me
# Host port the API is published on (default 8000)
API_HOST_PORT=8000
